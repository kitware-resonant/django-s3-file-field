{
  "name": "django-s3-file-field",
  "version": "0.0.0",
  "description": "A Javascript client library for django-s3-file-field.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kitware-resonant/django-s3-file-field.git"
  },
  "license": "Apache-2.0",
  "author": "Kitware, Inc. <kitware@kitware.com>",
  "type": "module",
  "exports": "./dist/client.js",
  "main": "./dist/client.js",
  "types": "./dist/client.d.ts",
  "files": [
    "NOTICE",
    "/src/",
    "/dist/"
  ],
  "scripts": {
    "build": "npm-run-all build:clean build:compile",
    "build:clean": "rimraf ./dist",
    "build:compile": "tsc",
    "format": "biome check --write --error-on-warnings",
    "prepack": "npm-run-all build",
    "test": "npm-run-all test:*",
    "test:lint": "biome ci --error-on-warnings",
    "test:type": "tsc --noEmit",
    "watch": "tsc --watch"
  },
  "dependencies": {
    "ky": "^2.2.0",
    "p-map": "^7.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@resonant/biome-config": "0.4.0",
    "npm-run-all2": "9.0.3",
    "rimraf": "6.1.3",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm"
    },
    "runtime": {
      "name": "node",
      "version": ">=24"
    }
  }
}
